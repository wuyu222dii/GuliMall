<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.atguigu.gulimall.ware.dao.WareSkuDao">

    <!-- Customize as needed -->
    <resultMap type="com.atguigu.gulimall.ware.entity.WareSkuEntity" id="wareSkuMap">
        <result property="id" column="id"/>
        <result property="skuId" column="sku_id"/>
        <result property="wareId" column="ware_id"/>
        <result property="stock" column="stock"/>
        <result property="skuName" column="sku_name"/>
        <result property="stockLocked" column="stock_locked"/>
    </resultMap>
    <insert id="addStock">
        INSERT INTO wms_ware_sku(sku_id, ware_id, stock, stock_locked, sku_name)
        VALUES (#{skuId}, #{wareId}, #{skuNum}, 0, #{skuName})
        ON DUPLICATE KEY UPDATE stock = stock + VALUES(stock)
    </insert>
    <select id="getSkuStock" resultType="java.lang.Long">
        select sum(stock - stock_locked)
        from wms_ware_sku
        where sku_id = #{skuId}
    </select>


</mapper>

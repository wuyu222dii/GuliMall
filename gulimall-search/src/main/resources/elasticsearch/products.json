{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0
  },
  "aliases": { "gulimall-products-write": {} },
  "mappings": {
    "_meta": {
      "gulimall_schema": 1
    },
    "dynamic": "strict",
    "properties": {
      "skuId": {
        "type": "long"
      },
      "spuId": {
        "type": "long"
      },
      "saleCount": {
        "type": "long"
      },
      "hotScore": {
        "type": "long"
      },
      "brandId": {
        "type": "long"
      },
      "catalogId": {
        "type": "long"
      },
      "skuImg": {
        "type": "keyword",
        "index": false,
        "doc_values": false
      },
      "brandImg": {
        "type": "keyword",
        "index": false,
        "doc_values": false
      },
      "brandName": {
        "type": "keyword"
      },
      "catalogName": {
        "type": "keyword"
      },
      "skuTitle": {
        "type": "text",
        "analyzer": "cjk"
      },
      "skuName": {
        "type": "text",
        "analyzer": "cjk"
      },
      "skuPrice": {
        "type": "scaled_float",
        "scaling_factor": 100
      },
      "hasStock": {
        "type": "boolean"
      },
      "attrs": {
        "type": "nested",
        "properties": {
          "attrId": {
            "type": "long"
          },
          "attrName": {
            "type": "keyword"
          },
          "attrValue": {
            "type": "keyword"
          }
        }
      }
    }
  }
}
